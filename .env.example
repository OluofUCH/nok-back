# Copy to .env for local development.
# On Vercel, set these under Project Settings -> Environment Variables.
# The VITE_* variables belong to the frontend project, not this API.

# --- Required ---
MONGODB_URI=
JWT_SECRET=

# --- Auth / session ---
JWT_EXPIRE=7d
JWT_ISSUER=
JWT_AUDIENCE=
SESSION_COOKIE_NAME=
CSRF_COOKIE_NAME=
COOKIE_SAME_SITE=
# Bearer session tokens. Enabled unless set to exactly "false". Required whenever this API
# is not first-party to its frontend: Safari blocks third-party cookie storage outright, so
# a cross-site cookie session cannot work there at all.
ALLOW_BEARER_AUTH=true

# --- CORS: the browser origins allowed to call this API ---
FRONTEND_URL=
CORS_ORIGINS=

# --- Google sign-in ---
GOOGLE_CLIENT_ID=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=
CONTACT_EMAIL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Orders / maintenance ---
INVENTORY_RESERVATION_MINUTES=
CRON_SECRET=

# --- Local only. Vercel sets PORT/NODE_ENV itself. ---
PORT=3001
NODE_ENV=development
